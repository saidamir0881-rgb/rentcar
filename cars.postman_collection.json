{
  "info": {
    "name": "Cars API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "carId",
      "value": "1"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Admin kirish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Barcha avtomobillar",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/cars"
      }
    },
    {
      "name": "ID orqali olish",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/cars/{{carId}}"
      }
    },
    {
      "name": "Qo‘shish",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/cars",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Chevrolet\",\n  \"is_new\": false,\n  \"price\": 15000,\n  \"year\": 2023,\n  \"model\": \"Cobalt\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('carId', String(pm.response.json().id));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Yangilash (5 maydon majburiy)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/cars/{{carId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Chevrolet\",\n  \"is_new\": false,\n  \"price\": 15000,\n  \"year\": 2023,\n  \"model\": \"Cobalt\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "O‘chirish",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/cars/{{carId}}"
      }
    },
    {
      "name": "Xato: maydon yetishmaydi",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/cars",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"brand\": \"Chevrolet\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}
